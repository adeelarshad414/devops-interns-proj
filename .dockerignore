# Docker reads the .dockerignore at the BUILD CONTEXT root (the repo root),
# not per-service ones. Without this, `node_modules`, git history and the deck
# would all be shipped into the build context.
**/node_modules
**/.git
.git
**/.DS_Store
**/npm-debug.log*

# Secrets must never enter the build context. Docker reads ONLY this root file,
# never the per-service .dockerignore files, so these patterns are the sole thing
# standing between a stray .env and a baked image layer. (.env.example is safe.)
**/.env
**/.env.*
**/*.env
!**/.env.example

# Tests and coverage are build-time only; keep them out of runtime images.
**/test
**/*.test.js
**/coverage

# Not needed inside images
planning/
*.pptx
*.pdf
docs/
observability/
k8s/
infra/
ansible/
swarm/
chaos/
load/
security/
vault/
sonar-project.properties
