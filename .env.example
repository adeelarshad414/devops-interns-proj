# Copy to .env. Every value here is a registered dummy - see DUMMY-VALUES.md.

NODE_ENV=development
LOG_LEVEL=info

# --- Tier 3: data ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=daig
POSTGRES_USER=daig
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY
DATABASE_URL=postgresql://daig:CHANGE_ME_DEV_ONLY@postgres:5432/daig

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=CHANGE_ME_DEV_ONLY

# --- Tier 2: service discovery ---
ORDERS_URL=http://orders:3001
KITCHEN_URL=http://kitchen:3002
DISPATCH_URL=http://dispatch:3003

# --- Secrets ---
JWT_SECRET=CHANGE_ME_DEV_ONLY
PAYMENT_API_KEY=CHANGE_ME_DEV_ONLY

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAMESPACE=daig
OTEL_TRACES_SAMPLER=parentbased_always_on
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040

# --- DevSecOps training. Mounts deliberately vulnerable endpoints on
# --- /insecure/*. The module refuses to load if NODE_ENV=production.
INSECURE_MODE=false

# --- Chaos toggles. Day 4 turns these on. ---
CHAOS_SLOW_DISPATCH=false
CHAOS_HOT_SURGE_LOOP=false
CHAOS_DROP_RATE=0
