# Rendered by OpenBao Agent. Do not edit - the agent overwrites it.
# Regenerated automatically whenever the underlying secret changes.

{{- with secret "daig/data/database" }}
DATABASE_URL={{ .Data.data.url }}
POSTGRES_HOST={{ .Data.data.host }}
POSTGRES_USER={{ .Data.data.username }}
{{- end }}

{{- with secret "daig/data/app" }}
JWT_SECRET={{ .Data.data.jwt_secret }}
{{- end }}

# Dynamic credential variant. The lease is renewed by the agent, and the file is
# re-rendered before it expires - which is the whole reason to use an agent for
# dynamic secrets rather than doing it in the application.
#
# {{- with secret "daig-db/creds/orders" }}
# DATABASE_USER={{ .Data.username }}
# DATABASE_PASSWORD={{ .Data.password }}
# {{- end }}
